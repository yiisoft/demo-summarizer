{
    "name": "yiisoft/app",
    "type": "project",
    "description": "Yii3 web application template",
    "keywords": [
        "yii3",
        "app"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/app/issues?state=open",
        "source": "https://github.com/yiisoft/app",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "test": "testo"
    },
    "require": {
        "php": "~8.5.0",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "aws/aws-sdk-php": "^3.401.1",
        "httpsoft/http-message": "^1.1.6",
        "league/flysystem": "^3.36.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "league/flysystem-local": "^3.35.3",
        "php-amqplib/php-amqplib": "^3.7.5",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.0.1",
        "yiisoft/db-migration": "^2.1.1",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/html": "^4.2",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/queue": "dev-master",
        "yiisoft/queue-amqp": "dev-master",
        "yiisoft/queue-redis": "dev-master",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/response-download": "^1.1",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.3",
        "yiisoft/validator": "^2.6.1",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "ext-dom": "*",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "guzzlehttp/psr7": "^3.1.0",
        "rector/rector": "^2.7.0",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/browser-kit": "^8.1.9",
        "symfony/css-selector": "^8.1.6",
        "symfony/http-client": "^8.1.9",
        "symfony/mime": "^8.1",
        "symfony/process": "^8.1.9",
        "testo/assert": "^0.1.17",
        "testo/codecov": "^0.2.5",
        "testo/lifecycle": "^0.1.9",
        "testo/test": "^0.1.8",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6.20.0",
        "vlucas/phpdotenv": "^5.7.0",
        "yiisoft/cache": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "yiisoft/config": true,
            "composer/installers": true
        }
    }
}
